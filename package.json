{
  "name": "wasm-masm-x86-editor",
  "version": "2.0.0",
  "description": "Portable Microsoft Assembly Language Editor with compilation, linking and x86 executable execution",
  "main": "./build/electron-main.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build:grammar": "node Boxedwine/scripts/build-grammar.mjs",
    "build:assets": "node scripts/chunk-guest.cjs",
    "test:assets": "node --test scripts/chunk-guest.test.cjs",
    "test:presentation": "node --test scripts/boxedwine-presentation.test.cjs",
    "check:public": "node Boxedwine/scripts/check-public.mjs",
    "preview": "node Boxedwine/scripts/serve-public.mjs",
    "build": "gulp",
    "gate": "node Boxedwine/harness/bw-headed.js masmgate --page app --runtime st --settle 120 && node Boxedwine/harness/bw-headed.js masmgate --page app --runtime mt --settle 150",
    "dev": "gulp watch",
    "build-electron": "gulp electron",
    "build-installer": "electron-builder",
    "deploy": "electron-builder build -mwl --publish always",
    "test:grammar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON Boxedwine/scripts/check-grammar.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/istareatscreens/wasm-masm-x86-editor"
  },
  "keywords": [
    "masm",
    "assembly",
    "x86",
    "wasm",
    "boxedwine",
    "editor"
  ],
  "author": "istareatscreens",
  "bugs": {
    "url": "https://github.com/istareatscreens/wasm-masm-x86-editor/issues"
  },
  "homepage": "https://github.com/istareatscreens/wasm-masm-x86-editor#readme",
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@types/node": "^24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "cssnano": "^7.1.9",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-file": "^0.4.0",
    "gulp-htmlmin": "^5.0.1",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sitemap": "^8.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "loader-utils": "^3.3.1",
    "postcss": "^8.5.28",
    "sass": "^1.104.1",
    "svgo": "^3.3.5",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "webpack": "^5.111.0",
    "webpack-merge": "^6.0.1",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@uiw/codemirror-themes-all": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "eol": "^0.9.1",
    "file-saver": "^2.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.7.2",
    "react-onclickoutside": "^6.13.2",
    "react-window": "^2.3.1",
    "thememirror": "^2.0.1",
    "use-debounce": "^5.2.1"
  },
  "build": {
    "appId": "com.isas.wasm-masm-x86-editor",
    "productName": "WASM MASM x86 Editor",
    "extends": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "./build/**/*",
      "package.json"
    ],
    "nsis": {
      "uninstallDisplayName": "WASM MASM x86 Editor",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}-osx.${ext}",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "maintainer": "istareatscreens",
      "target": [
        "tar.gz",
        "deb",
        "rpm",
        "pacman"
      ]
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "electron-winstaller": false,
    "es5-ext": false
  }
}
